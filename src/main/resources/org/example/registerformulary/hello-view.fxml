<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registerformulary.RegisterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre" />
   <TextField fx:id="txtNombre" />
   <Text layoutX="83.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Apellidos" />
   <TextField fx:id="txtApellidos" layoutX="30.0" layoutY="67.0" />
   <Text layoutX="83.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email" />
   <TextField fx:id="txtEmail" layoutX="30.0" layoutY="112.0" />
   <Text layoutX="83.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Edad" />
   <TextField fx:id="txtEdad" layoutX="30.0" layoutY="157.0" />
   <CheckBox fx:id="chkCondiciones" mnemonicParsing="false" text="Acepto los terminos y condiciones" />
   <Button mnemonicParsing="false" onAction="#handleRegistrarse" text="Registrarse" />
   <Label fx:id="lblMensaje" text="Mensaje" />
</VBox>
